mean_coverage_ci_width_pct = mean(coverage_ci_width_pct, na.rm = TRUE),
n_points = dplyr::n(),
.groups = "drop"
) %>%
dplyr::mutate(
z_neg_coverage = as.numeric(scale(-mean_coverage_seen_pct)),
z_ci_width = as.numeric(scale(mean_coverage_ci_width_pct)),
combined_score = z_neg_coverage + z_ci_width
) %>%
dplyr::arrange(combined_score, dplyr::desc(mean_coverage_seen_pct), mean_coverage_ci_width_pct)
knitr::kable(
loso_deployable_coverage_ranking,
digits = 3,
caption = "LOSO ranking: realized seen-class coverage, CI tightness, and combined score"
) %>%
kableExtra::kable_styling(
bootstrap_options = c("striped", "condensed"),
full_width = FALSE,
position = "left"
)
p_deployable_requested_vs_realized_risk
p_deployable_requested_vs_coverage
