)
}
context_df <- readr::read_csv(context_path, show_col_types = FALSE) %>%
mutate(
label_set = recode(label_set,
full_subtypes = "Full subtypes",
collapsed_classes = "Collapsed classes"),
split_type = toupper(split_type),
target_name = recode(target_name,
correct_vs_noncorrect = "Correct vs Non-correct",
seen_vs_unseen = "Seen vs Unseen",
accept_seen_and_correct = "Accept (seen and correct)",
accept_seen_and_correct_from_heads = "Accept (combined heads)",
p_correct_head = "P(correct) head",
p_id_head = "P(ID) head",
p_unseen_head = "P(unseen) head")
) %>%
mutate(
# Newer exports provide both a stable key and a readable regime name.
family_key = if ("family_key" %in% colnames(.)) family_key else NA_character_,
family_name = if ("family_name" %in% colnames(.)) family_name else NA_character_,
family_name = dplyr::coalesce(family_name, family_key, "Unknown regime"),
scenario_name = dplyr::coalesce(scenario_name, family_name),
task_key = dplyr::coalesce(task_key, target_name)
)
outer_all_df <- if (file.exists(outer_all_path)) {
if (file.exists(outer_df_cache_path)) {
# Reuse precomputed outer_df cache to skip recomputation on repeated renders.
as.data.frame(data.table::fread(outer_df_cache_path, showProgress = FALSE))
} else {
# Read only the fields used in this report to reduce CSV parse time.
outer_cols_needed <- c(
"label_set", "split_type", "scenario_name", "family_name",
"task_key", "target_name", "combine_method", "recipe_features",
"risk_all_accepted", "coverage_seen", "auprc_outer"
)
# fread(select=...) is strict, so select only columns that are present.
outer_cols_present <- intersect(
outer_cols_needed,
names(data.table::fread(outer_all_path, nrows = 0L, showProgress = FALSE))
)
outer_df <- as.data.frame(data.table::fread(
outer_all_path,
select = outer_cols_present,
showProgress = FALSE
))
# Normalize optional columns once so downstream code can stay simple.
if (!"combine_method" %in% colnames(outer_df)) outer_df$combine_method <- NA_character_
if (!"recipe_features" %in% colnames(outer_df)) outer_df$recipe_features <- NA_character_
if (!"scenario_name" %in% colnames(outer_df)) outer_df$scenario_name <- NA_character_
if (!"family_name" %in% colnames(outer_df)) outer_df$family_name <- NA_character_
if (!"task_key" %in% colnames(outer_df)) outer_df$task_key <- NA_character_
if (!"target_name" %in% colnames(outer_df)) outer_df$target_name <- NA_character_
outer_df_prepared <- outer_df %>%
# Keep only rows used by target-risk ranking sections.
filter(split_type %in% c("CV", "LOSO")) %>%
filter(task_key == "accept_combined" | grepl("^combined_accept_", task_key)) %>%
mutate(
label_set = recode(label_set,
full_subtypes = "Full subtypes",
collapsed_classes = "Collapsed classes"),
split_type = toupper(split_type),
scenario_name = dplyr::coalesce(scenario_name, family_name),
task_key = dplyr::coalesce(task_key, target_name),
recipe_features = dplyr::coalesce(recipe_features, "max_prob (baseline only)")
)
# Persist prepared table so repeated report renders are fast.
readr::write_csv(outer_df_prepared, outer_df_cache_path)
outer_df_prepared
}
} else {
data.frame()
}
rank_target_risk_recipes <- function(df) {
if (nrow(df) == 0) return(data.frame())
required_cols <- c("risk_all_accepted", "coverage_seen", "auprc_outer")
if (!all(required_cols %in% colnames(df))) return(data.frame())
df %>%
filter(split_type %in% c("CV", "LOSO")) %>%
filter(task_key == "accept_combined" | grepl("^combined_accept_", task_key)) %>%
group_by(scenario_name, task_key, combine_method, recipe_features) %>%
summarise(
n_outer_rows = n(),
n_splits = n_distinct(split_type),
n_label_sets = n_distinct(label_set),
mean_risk_all_accepted = mean(risk_all_accepted, na.rm = TRUE),
sd_risk_all_accepted = sd(risk_all_accepted, na.rm = TRUE),
mean_coverage_seen = mean(coverage_seen, na.rm = TRUE),
sd_coverage_seen = sd(coverage_seen, na.rm = TRUE),
mean_auprc_outer = mean(auprc_outer, na.rm = TRUE),
sd_auprc_outer = sd(auprc_outer, na.rm = TRUE),
.groups = "drop"
) %>%
mutate(meets_target_mean_risk = mean_risk_all_accepted <= 0.05) %>%
arrange(
desc(meets_target_mean_risk),
desc(mean_coverage_seen),
sd_risk_all_accepted,
sd_coverage_seen,
desc(mean_auprc_outer),
desc(n_outer_rows),
scenario_name,
task_key
)
}
