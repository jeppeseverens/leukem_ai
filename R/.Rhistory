# Summarize F1 score by enrichment class and cohort type
f1_summary <- f1_per_class_enriched %>%
group_by(enrichment_class, cohort_type) %>%
summarise(
n_classes = n(),
mean_f1 = mean(f1, na.rm = TRUE),
