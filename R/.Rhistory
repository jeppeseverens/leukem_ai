rank_target_risk_recipes <- function(df) {
if (nrow(df) == 0) return(data.frame())
required_cols <- c("risk_all_accepted", "coverage_seen", "auprc_outer")
if (!all(required_cols %in% colnames(df))) return(data.frame())
df %>%
filter(split_type %in% c("CV", "LOSO")) %>%
filter(task_key == "accept_combined" | grepl("^combined_accept_", task_key)) %>%
group_by(scenario_name, task_key, combine_method, recipe_features) %>%
summarise(
n_outer_rows = n(),
n_splits = n_distinct(split_type),
n_label_sets = n_distinct(label_set),
mean_risk_all_accepted = mean(risk_all_accepted, na.rm = TRUE),
sd_risk_all_accepted = sd(risk_all_accepted, na.rm = TRUE),
mean_coverage_seen = mean(coverage_seen, na.rm = TRUE),
sd_coverage_seen = sd(coverage_seen, na.rm = TRUE),
mean_auprc_outer = mean(auprc_outer, na.rm = TRUE),
sd_auprc_outer = sd(auprc_outer, na.rm = TRUE),
.groups = "drop"
) %>%
mutate(meets_target_mean_risk = mean_risk_all_accepted <= 0.05) %>%
arrange(
desc(meets_target_mean_risk),
desc(mean_coverage_seen),
sd_risk_all_accepted,
sd_coverage_seen,
desc(mean_auprc_outer),
desc(n_outer_rows),
scenario_name,
task_key
)
}
View(outer_all_df)
# Build one recommended recipe per setting, ranked by highest selected AUPRC.
recipe_candidates <- context_df %>%
filter(split_type %in% c("CV", "LOSO")) %>%
# Compare only whole reject-objective outputs, not standalone head diagnostics.
filter(task_key == "accept_combined" | grepl("^combined_accept_", task_key)) %>%
group_by(label_set, split_type, scenario_key, scenario_name, task_key, target_name) %>%
summarise(
n_contexts = n(),
base_model = dplyr::first(base_model),
selected_better_rate = mean(verdict_selected_vs_baseline == "selected_better", na.rm = TRUE),
baseline_better_rate = mean(verdict_selected_vs_baseline == "baseline_better", na.rm = TRUE),
mean_auprc_baseline = mean(auprc_baseline, na.rm = TRUE),
mean_auprc_selected = mean(auprc_selected, na.rm = TRUE),
mean_auprc_full = mean(auprc_full, na.rm = TRUE),
sd_auprc_baseline = sd(auprc_baseline, na.rm = TRUE),
sd_auprc_selected = sd(auprc_selected, na.rm = TRUE),
sd_auprc_full = sd(auprc_full, na.rm = TRUE),
mean_delta_auprc = mean(delta_auprc_selected_vs_baseline, na.rm = TRUE),
sd_delta_auprc = sd(delta_auprc_selected_vs_baseline, na.rm = TRUE),
.groups = "drop"
)
# Derive stable feature set summaries for non-combined tasks.
recipe_features <- context_df %>%
filter(!grepl("^combined_accept_", task_key)) %>%
mutate(selected_features = ifelse(selected_features == "", NA_character_, selected_features)) %>%
select(label_set, split_type, scenario_key, scenario_name, task_key, target_name, target_fold, selected_features) %>%
tidyr::separate_rows(selected_features, sep = ";") %>%
filter(!is.na(selected_features), selected_features != "") %>%
group_by(label_set, split_type, scenario_key, scenario_name, task_key, target_name, selected_features) %>%
summarise(
n_selected_folds = n_distinct(target_fold),
.groups = "drop"
) %>%
rename(feature = selected_features)
recipe_feature_rollup <- recipe_features %>%
left_join(
context_df %>%
group_by(label_set, split_type, scenario_key, scenario_name, task_key, target_name) %>%
summarise(n_total_folds = n_distinct(target_fold), .groups = "drop"),
by = c("label_set", "split_type", "scenario_key", "scenario_name", "task_key", "target_name")
) %>%
mutate(selection_rate = n_selected_folds / pmax(1, n_total_folds)) %>%
group_by(label_set, split_type, scenario_key, scenario_name, task_key, target_name) %>%
summarise(
stable_features = paste(feature[selection_rate >= 0.6], collapse = ";"),
any_selected_features = paste(feature[order(-selection_rate)], collapse = ";"),
.groups = "drop"
)
# Keep a readable combined head recipe for combined tasks.
combined_recipe_text <- context_df %>%
filter(grepl("^combined_accept_", task_key), selected_features != "") %>%
group_by(label_set, split_type, scenario_key, scenario_name, task_key, target_name, selected_features) %>%
summarise(n = n(), .groups = "drop") %>%
group_by(label_set, split_type, scenario_key, scenario_name, task_key, target_name) %>%
arrange(desc(n), .by_group = TRUE) %>%
slice(1L) %>%
ungroup() %>%
rename(recommended_combined_recipe = selected_features)
best_recipe_table <- recipe_candidates %>%
left_join(
recipe_feature_rollup,
by = c("label_set", "split_type", "scenario_key", "scenario_name", "task_key", "target_name")
) %>%
left_join(
combined_recipe_text,
by = c("label_set", "split_type", "scenario_key", "scenario_name", "task_key", "target_name")
) %>%
group_by(label_set, split_type) %>%
arrange(desc(mean_auprc_selected), desc(mean_delta_auprc), desc(selected_better_rate), .by_group = TRUE) %>%
slice(1L) %>%
ungroup() %>%
mutate(
combine_method = dplyr::case_when(
task_key == "combined_accept_product" ~ "product",
task_key == "combined_accept_min" ~ "min",
task_key == "combined_accept_harmonic" ~ "harmonic",
TRUE ~ NA_character_
),
recommended_features = dplyr::if_else(
grepl("^combined_accept_", dplyr::coalesce(task_key, "")),
dplyr::coalesce(recommended_combined_recipe, "head recipes vary by fold"),
dplyr::coalesce(dplyr::if_else(
!is.na(stable_features) & stable_features != "",
stable_features,
any_selected_features
), "max_prob (baseline only)")
)
) %>%
select(
label_set, split_type,
base_model,
scenario_name, task_key, target_name,
combine_method,
n_contexts, selected_better_rate, baseline_better_rate,
mean_auprc_baseline, sd_auprc_baseline,
mean_auprc_selected, sd_auprc_selected,
mean_auprc_full, sd_auprc_full,
mean_delta_auprc, sd_delta_auprc,
recommended_features
) %>%
arrange(label_set, split_type)
best_recipe_table
# Fold-level spread for the winning recipe in each setting.
winner_fold_df <- best_recipe_table %>%
select(label_set, split_type, scenario_name, task_key, target_name) %>%
left_join(
context_df %>%
select(label_set, split_type, scenario_name, task_key, target_name, target_fold, auprc_selected),
by = c("label_set", "split_type", "scenario_name", "task_key", "target_name")
) %>%
mutate(setting = paste0(split_type, " | ", label_set))
winner_mean_df <- winner_fold_df %>%
group_by(setting) %>%
summarise(mean_auprc = mean(auprc_selected, na.rm = TRUE), .groups = "drop")
ggplot(winner_fold_df, aes(x = setting, y = auprc_selected, fill = split_type)) +
geom_boxplot(alpha = 0.8, outlier.shape = NA, width = 0.65) +
geom_jitter(width = 0.12, alpha = 0.45, size = 1.8, color = "grey35") +
geom_point(
data = winner_mean_df,
aes(x = setting, y = mean_auprc),
inherit.aes = FALSE,
shape = 21, size = 2.8, stroke = 0.5,
fill = "white", color = "black"
) +
theme_bw() +
labs(
title = "Winning Recipe AUPRC by Fold",
subtitle = "One winner per CV/LOSO x Full/Collapsed setting",
x = "Setting",
y = "AUPRC (selected recipe)",
fill = "Split"
)
if (nrow(outer_all_df) == 0) {
data.frame(note = "No full outer-combination CSV found. Run the latest analysis script first.")
} else if (!all(c("risk_all_accepted", "coverage_seen") %in% colnames(outer_all_df))) {
data.frame(note = "Current outer-combination CSV has no target-risk columns. Re-run analysis script.")
} else {
outer_all_df %>%
filter(split_type %in% c("CV", "LOSO")) %>%
filter(task_key == "accept_combined" | grepl("^combined_accept_", task_key)) %>%
group_by(label_set, split_type, scenario_name, task_key, combine_method, recipe_features) %>%
summarise(
n_outer_rows = n(),
mean_risk_all_accepted = mean(risk_all_accepted, na.rm = TRUE),
sd_risk_all_accepted = sd(risk_all_accepted, na.rm = TRUE),
mean_coverage_seen = mean(coverage_seen, na.rm = TRUE),
sd_coverage_seen = sd(coverage_seen, na.rm = TRUE),
mean_auprc_outer = mean(auprc_outer, na.rm = TRUE),
sd_auprc_outer = sd(auprc_outer, na.rm = TRUE),
.groups = "drop"
) %>%
mutate(meets_target_mean_risk = mean_risk_all_accepted <= 0.05) %>%
group_by(label_set, split_type) %>%
arrange(
desc(meets_target_mean_risk),
desc(mean_coverage_seen),
sd_risk_all_accepted,
sd_coverage_seen,
desc(mean_auprc_outer),
.by_group = TRUE
) %>%
slice(1L) %>%
ungroup() %>%
arrange(label_set, split_type)
}
if (nrow(outer_all_df) == 0) {
data.frame(note = "No full outer-combination CSV found. Run the latest analysis script first.")
} else {
overall_outer_ranked <- rank_target_risk_recipes(outer_all_df)
overall_outer_best <- overall_outer_ranked %>% slice(1L)
overall_outer_best
}
if (nrow(outer_all_df) > 0) {
rank_target_risk_recipes(outer_all_df)
}
