read_uv_curve(mv_root, "standard", md, "loso", "Standard", mt, pool_scope = "full_pool"),
read_uv_curve(mv_root, "with_leftout", md, "cv", "With left-out", mt, pool_scope = "full_pool"),
read_uv_curve(mv_root, "with_leftout", md, "loso", "With left-out", mt, pool_scope = "full_pool"),
read_uv_curve(mv_root, "with_leftout_ood_aware", md, "cv", "OOD-aware calib.", mt, pool_scope = "full_pool"),
read_uv_curve(mv_root, "with_leftout_ood_aware", md, "loso", "OOD-aware calib.", mt, pool_scope = "full_pool"),
read_uv_curve(mv_root, "with_leftout_two_head", md, "cv", "Two-head calib.", mt, pool_scope = "full_pool"),
read_uv_curve(mv_root, "with_leftout_two_head", md, "loso", "Two-head calib.", mt, pool_scope = "full_pool")
)
})
)
if (!is.null(curve_compare) && nrow(curve_compare) > 0) {
regime_row_order <- c("Standard", "With left-out", "OOD-aware calib.", "Two-head calib.")
curve_compare <- curve_compare %>%
dplyr::filter(is.finite(risk), is.finite(coverage), !is.na(calibration)) %>%
dplyr::mutate(
regime = factor(
regime,
levels = regime_row_order[regime_row_order %in% unique(regime)]
),
split_type = factor(split_type, levels = c("CV", "LOSO")),
calibration = factor(calibration, levels = c("Multivariate", "Univariate"))
)
p_curve_compare <- ggplot(
curve_compare,
aes(x = risk, y = coverage, color = method, linetype = calibration)
) +
geom_line(linewidth = 1.1) +
facet_grid(regime ~ split_type) +
