name = "Confidence"
) +
labs(
title = "Monotonic risk-coverage: multivariate vs univariate (striped)",
subtitle = "Four training regimes; augmented rows use seen-class coverage where applicable",
x = "Risk on accepted samples (%)",
y = "Coverage (%)",
color = "Method"
) +
theme_bw() +
theme(strip.text.y = element_text(size = 9)) +
xlim(0, 10)
print(p_curve_compare)
}
if (!is.null(curve_compare_full) && nrow(curve_compare_full) > 0) {
regime_row_order <- c("Standard", "With left-out", "OOD-aware calib.", "Two-head calib.")
curve_compare_full <- curve_compare_full %>%
dplyr::filter(is.finite(risk), is.finite(coverage), !is.na(calibration)) %>%
dplyr::mutate(
regime = factor(
regime,
levels = regime_row_order[regime_row_order %in% unique(regime)]
),
split_type = factor(split_type, levels = c("CV", "LOSO")),
calibration = factor(calibration, levels = c("Multivariate", "Univariate"))
)
p_curve_compare_full <- ggplot(
curve_compare_full,
aes(x = risk, y = coverage, color = method, linetype = calibration)
) +
geom_line(linewidth = 1.1) +
facet_grid(regime ~ split_type) +
scale_color_manual(values = c(
"Weighted ensemble" = "#377eb8",
"Product ensemble" = "#e41a1c"
)) +
scale_linetype_manual(
values = c("Multivariate" = "solid", "Univariate" = "longdash"),
labels = c("Multivariate", "Univariate (Platt / two-head)"),
name = "Confidence"
) +
labs(
title = "Monotonic risk-coverage (full pool): multivariate vs univariate",
subtitle = "Augmented regimes: coverage = 100*(1 - perc_rejected); risk = 100*(1 - accuracy) on accepted.",
x = "Risk on accepted samples (%)",
y = "Coverage (%)",
color = "Method"
) +
theme_bw() +
theme(strip.text.y = element_text(size = 9)) +
xlim(0, 10)
print(p_curve_compare_full)
}
library(dplyr)
library(ggplot2)
library(tidyr)
# Compare global ensemble variants on multivariate monotonic risk-coverage curves.
build_monotonic_curve <- function(df) {
if (is.null(df) || nrow(df) == 0) return(NULL)
df <- df[is.finite(df$risk) & is.finite(df$coverage), , drop = FALSE]
if (nrow(df) == 0) return(NULL)
df %>%
dplyr::arrange(risk, dplyr::desc(coverage)) %>%
dplyr::mutate(coverage_mono = cummax(coverage)) %>%
dplyr::group_by(risk) %>%
dplyr::summarise(coverage = max(coverage_mono, na.rm = TRUE), .groups = "drop")
}
build_curve_from_decisions <- function(decisions, split_type, regime_label, method_label) {
if (is.null(decisions) || nrow(decisions) == 0) return(NULL)
if (!all(c("confidence", "truth", "pred") %in% colnames(decisions))) return(NULL)
decisions <- decisions %>%
dplyr::mutate(
is_leftout = if ("is_leftout" %in% colnames(.)) as.logical(is_leftout) else FALSE,
is_known = !is_leftout,
correct = as.integer(truth == pred)
)
cutoff_grid <- seq(0, 1, by = 0.01)
rows <- lapply(cutoff_grid, function(co) {
df <- decisions %>%
dplyr::mutate(accepted = confidence >= co)
# Coverage and risk restricted to in-distribution (non-left-out) rows.
known_df <- df[df$is_known, , drop = FALSE]
n_known_total <- nrow(known_df)
n_known_acc <- sum(known_df$accepted, na.rm = TRUE)
coverage_seen <- if (n_known_total > 0) n_known_acc / n_known_total else NA_real_
accepted_known <- known_df[known_df$accepted, , drop = FALSE]
risk_seen <- if (nrow(accepted_known) > 0) 1 - mean(accepted_known$correct, na.rm = TRUE) else NA_real_
data.frame(
prob_cutoff = co,
risk = 100 * risk_seen,
coverage = 100 * coverage_seen,
stringsAsFactors = FALSE
)
})
pooled <- dplyr::bind_rows(rows)
pooled <- pooled[is.finite(pooled$risk) & is.finite(pooled$coverage), , drop = FALSE]
if (nrow(pooled) == 0) return(NULL)
mono <- build_monotonic_curve(pooled)
if (is.null(mono) || nrow(mono) == 0) return(NULL)
mono %>%
dplyr::mutate(
split_type = toupper(split_type),
regime = regime_label,
method = method_label
)
}
read_mv_curve <- function(root_dir, regime_dir, model_dir, split_type, regime_label, method_label) {
# Augmented left-out regimes: heldout CSV includes coverage_known; RDS names use regime_dir prefix.
mv_regime_leftout_variants <- c("with_leftout", "with_leftout_ood_aware", "with_leftout_two_head")
mv_model_aliases <- unique(c(
model_dir,
paste0(model_dir, "_MV"),
paste0(model_dir, "_MV_leftout"),
paste0(model_dir, "_MV_leftout_ood_aware"),
paste0(model_dir, "_MV_leftout_two_head")
))
if (regime_dir %in% mv_regime_leftout_variants) {
curve_path <- file.path(root_dir, "ensemble_multivariate", regime_dir, model_dir, paste0("risk_coverage_heldout_curve_raw_", split_type, ".csv"))
if (file.exists(curve_path)) {
raw <- read.csv(curve_path, stringsAsFactors = FALSE)
if (nrow(raw) > 0) {
raw <- raw[raw$model %in% mv_model_aliases, , drop = FALSE]
if (nrow(raw) > 0 && all(c("accuracy", "coverage_known") %in% colnames(raw))) {
pooled <- raw %>%
dplyr::filter(is.finite(accuracy), is.finite(coverage_known)) %>%
dplyr::transmute(prob_cutoff, risk = 100 * (1 - accuracy), coverage = 100 * coverage_known) %>%
dplyr::group_by(prob_cutoff) %>%
dplyr::summarise(
risk = mean(risk, na.rm = TRUE),
coverage = mean(coverage, na.rm = TRUE),
.groups = "drop"
)
mono <- build_monotonic_curve(pooled)
if (!is.null(mono) && nrow(mono) > 0) {
return(mono %>% dplyr::mutate(split_type = toupper(split_type), regime = regime_label, method = method_label))
}
}
}
}
decision_path <- file.path(
root_dir,
"ensemble_multivariate",
regime_dir,
model_dir,
paste0("global_ensemble_prediction_decisions_", regime_dir, "_", model_dir, "_", split_type, ".rds")
)
if (!file.exists(decision_path)) return(NULL)
decisions <- readRDS(decision_path)
return(build_curve_from_decisions(decisions, split_type, regime_label, method_label))
}
curve_path <- file.path(root_dir, "ensemble_multivariate", regime_dir, model_dir, paste0("risk_coverage_heldout_curve_raw_", split_type, ".csv"))
if (!file.exists(curve_path)) return(NULL)
raw <- read.csv(curve_path, stringsAsFactors = FALSE)
if (nrow(raw) == 0) return(NULL)
# Guard against mixed-model files by keeping only rows for this model.
if ("model" %in% colnames(raw)) {
raw <- raw[raw$model %in% mv_model_aliases, , drop = FALSE]
}
if (nrow(raw) == 0) return(NULL)
pooled <- raw %>%
dplyr::mutate(
risk = 100 * (1 - accuracy),
coverage = 100 * (1 - perc_rejected)
) %>%
dplyr::group_by(prob_cutoff) %>%
dplyr::summarise(
risk = mean(risk, na.rm = TRUE),
coverage = mean(coverage, na.rm = TRUE),
.groups = "drop"
)
mono <- build_monotonic_curve(pooled)
if (is.null(mono) || nrow(mono) == 0) return(NULL)
mono %>%
dplyr::mutate(
split_type = toupper(split_type),
regime = regime_label,
method = method_label
)
}
# Univariate (simple Platt / two-head) heldout curves; must precede curve_compare.
read_uv_curve <- function(root_dir, regime_dir, model_dir, split_type, regime_label, method_label) {
uv_augmented_regimes <- c("with_leftout", "with_leftout_ood_aware", "with_leftout_two_head")
if (regime_dir %in% uv_augmented_regimes) {
curve_path <- file.path(
root_dir,
regime_dir,
paste0("risk_coverage_heldout_curve_raw_", split_type, ".csv")
)
if (file.exists(curve_path)) {
raw <- read.csv(curve_path, stringsAsFactors = FALSE)
if (nrow(raw) > 0) {
raw <- raw %>% dplyr::filter(model == model_dir)
if (nrow(raw) > 0 && all(c("accuracy", "coverage_known") %in% colnames(raw))) {
pooled <- raw %>%
dplyr::filter(is.finite(accuracy), is.finite(coverage_known)) %>%
dplyr::transmute(prob_cutoff, risk = 100 * (1 - accuracy), coverage = 100 * coverage_known) %>%
dplyr::group_by(prob_cutoff) %>%
dplyr::summarise(
risk = mean(risk, na.rm = TRUE),
coverage = mean(coverage, na.rm = TRUE),
.groups = "drop"
)
mono <- build_monotonic_curve(pooled)
if (!is.null(mono) && nrow(mono) > 0) {
return(mono %>% dplyr::mutate(
split_type = toupper(split_type), regime = regime_label, method = method_label,
calibration = "Univariate"
))
}
}
}
}
decision_path <- file.path(
root_dir,
regime_dir,
paste0("global_ensemble_prediction_decisions_", regime_dir, "_", model_dir, "_", split_type, ".rds")
)
if (!file.exists(decision_path)) return(NULL)
decisions <- readRDS(decision_path)
out <- build_curve_from_decisions(decisions, split_type, regime_label, method_label)
if (is.null(out)) return(NULL)
return(out %>% dplyr::mutate(calibration = "Univariate"))
}
curve_path <- file.path(
root_dir,
regime_dir,
paste0("risk_coverage_heldout_curve_raw_", split_type, ".csv")
)
if (!file.exists(curve_path)) return(NULL)
raw <- read.csv(curve_path, stringsAsFactors = FALSE)
if (nrow(raw) == 0) return(NULL)
pooled <- raw %>%
dplyr::filter(model == model_dir) %>%
dplyr::mutate(
risk = 100 * (1 - accuracy),
coverage = 100 * (1 - perc_rejected)
) %>%
dplyr::group_by(prob_cutoff) %>%
dplyr::summarise(
risk = mean(risk, na.rm = TRUE),
coverage = mean(coverage, na.rm = TRUE),
.groups = "drop"
)
mono <- build_monotonic_curve(pooled)
if (is.null(mono) || nrow(mono) == 0) return(NULL)
mono %>%
dplyr::mutate(
split_type = toupper(split_type),
regime = regime_label,
method = method_label,
calibration = "Univariate"
)
}
mv_root_merged <- "../data/out/outer_cv/outer_cv_analysis_outputs_merged_summed"
mv_root_unmerged <- "../data/out/outer_cv/outer_cv_analysis_outputs_unmerged_maxprob"
# Later chunks (e.g. product MV by regime) use merged outputs by default.
mv_root <- mv_root_merged
mv_models <- tibble::tribble(
~model_dir,                    ~method,
"Global_Optimized",            "Weighted ensemble",
"Global_Product_Optimized",    "Product ensemble"
)
bind_curve_compare <- function(root_dir) {
dplyr::bind_rows(
lapply(seq_len(nrow(mv_models)), function(i) {
md <- mv_models$model_dir[i]
mt <- mv_models$method[i]
dplyr::bind_rows(
read_mv_curve(root_dir, "standard", md, "cv", "Standard", mt) %>%
dplyr::mutate(calibration = "Multivariate"),
read_mv_curve(root_dir, "standard", md, "loso", "Standard", mt) %>%
dplyr::mutate(calibration = "Multivariate"),
read_mv_curve(root_dir, "with_leftout", md, "cv", "With left-out", mt) %>%
dplyr::mutate(calibration = "Multivariate"),
read_mv_curve(root_dir, "with_leftout", md, "loso", "With left-out", mt) %>%
dplyr::mutate(calibration = "Multivariate"),
read_mv_curve(root_dir, "with_leftout_ood_aware", md, "cv", "OOD-aware calib.", mt) %>%
dplyr::mutate(calibration = "Multivariate"),
read_mv_curve(root_dir, "with_leftout_ood_aware", md, "loso", "OOD-aware calib.", mt) %>%
dplyr::mutate(calibration = "Multivariate"),
read_mv_curve(root_dir, "with_leftout_two_head", md, "cv", "Two-head calib.", mt) %>%
dplyr::mutate(calibration = "Multivariate"),
read_mv_curve(root_dir, "with_leftout_two_head", md, "loso", "Two-head calib.", mt) %>%
dplyr::mutate(calibration = "Multivariate"),
read_uv_curve(root_dir, "standard", md, "cv", "Standard", mt),
read_uv_curve(root_dir, "standard", md, "loso", "Standard", mt),
read_uv_curve(root_dir, "with_leftout", md, "cv", "With left-out", mt),
read_uv_curve(root_dir, "with_leftout", md, "loso", "With left-out", mt),
read_uv_curve(root_dir, "with_leftout_ood_aware", md, "cv", "OOD-aware calib.", mt),
read_uv_curve(root_dir, "with_leftout_ood_aware", md, "loso", "OOD-aware calib.", mt),
read_uv_curve(root_dir, "with_leftout_two_head", md, "cv", "Two-head calib.", mt),
read_uv_curve(root_dir, "with_leftout_two_head", md, "loso", "Two-head calib.", mt)
)
})
)
}
curve_compare_merged <- bind_curve_compare(mv_root_merged)
curve_compare_unmerged <- bind_curve_compare(mv_root_unmerged)
format_curve_compare_plot_tbl <- function(df) {
regime_row_order <- c("Standard", "With left-out", "OOD-aware calib.", "Two-head calib.")
df %>%
dplyr::filter(is.finite(risk), is.finite(coverage), !is.na(calibration)) %>%
dplyr::mutate(
regime = factor(
regime,
levels = regime_row_order[regime_row_order %in% unique(regime)]
),
split_type = factor(split_type, levels = c("CV", "LOSO")),
calibration = factor(calibration, levels = c("Multivariate", "Univariate"))
)
}
if (!is.null(curve_compare_merged) && nrow(curve_compare_merged) > 0) {
curve_compare <- format_curve_compare_plot_tbl(curve_compare_merged)
p_curve_compare <- ggplot(
curve_compare,
aes(x = risk, y = coverage, color = method, linetype = calibration)
) +
geom_line(linewidth = 1.1) +
facet_grid(regime ~ split_type) +
scale_color_manual(values = c(
"Weighted ensemble" = "#377eb8",
"Product ensemble" = "#e41a1c"
)) +
scale_linetype_manual(
values = c("Multivariate" = "solid", "Univariate" = "longdash"),
labels = c("Multivariate", "Univariate (Platt / two-head)"),
name = "Confidence"
) +
labs(
title = "Monotonic risk-coverage: multivariate vs univariate (striped)",
subtitle = "Collapsed classes (merged labels); four training regimes; augmented rows use seen-class coverage",
x = "Risk on accepted samples (%)",
y = "Coverage (%)",
color = "Method"
) +
theme_bw() +
theme(strip.text.y = element_text(size = 9)) +
xlim(0, 10)
print(p_curve_compare)
}
if (!is.null(curve_compare_unmerged) && nrow(curve_compare_unmerged) > 0) {
curve_compare_full_subtypes <- format_curve_compare_plot_tbl(curve_compare_unmerged)
p_curve_compare_full_subtypes <- ggplot(
curve_compare_full_subtypes,
aes(x = risk, y = coverage, color = method, linetype = calibration)
) +
geom_line(linewidth = 1.1) +
facet_grid(regime ~ split_type) +
scale_color_manual(values = c(
"Weighted ensemble" = "#377eb8",
"Product ensemble" = "#e41a1c"
)) +
scale_linetype_manual(
values = c("Multivariate" = "solid", "Univariate" = "longdash"),
labels = c("Multivariate", "Univariate (Platt / two-head)"),
name = "Confidence"
) +
labs(
title = "Monotonic risk-coverage: multivariate vs univariate (striped)",
subtitle = "Full subtype granularity (unmerged labels); same metrics as merged panel",
x = "Risk on accepted samples (%)",
y = "Coverage (%)",
color = "Method"
) +
theme_bw() +
theme(strip.text.y = element_text(size = 9)) +
xlim(0, 10)
print(p_curve_compare_full_subtypes)
}
