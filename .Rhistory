dplyr::mutate(calibration = "Multivariate"),
read_mv_curve(mv_root, "with_leftout_two_head", md, "cv", "Two-head calib.", mt, pool_scope = "full_pool") %>%
dplyr::mutate(calibration = "Multivariate"),
read_mv_curve(mv_root, "with_leftout_two_head", md, "loso", "Two-head calib.", mt, pool_scope = "full_pool") %>%
dplyr::mutate(calibration = "Multivariate"),
