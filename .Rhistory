# Get the actual y-axis levels as they appear on the plot (bottom to top)
axis_class_levels <- levels(f1_comparison_plot$Class)
axis_class_levels <- axis_class_levels[axis_class_levels %in% unique(f1_comparison_plot$Class)]
# Y-axis label colours: one colour per category (all classes coloured by their group)
cls_to_cat <- setNames(as.character(f1_comparison_plot$Category[match(axis_class_levels, f1_comparison_plot$Class)]), axis_class_levels)
cls_to_cat[is.na(cls_to_cat)] <- "Other"
axis_text_colors <- setNames(category_colors[cls_to_cat], axis_class_levels)
# Create labels with bold formatting for merged classes
# Replace ";" with "::" in labels so element_markdown does not parse semicolon as CSS (e.g. GATA2;MECOM -> GATA2::MECOM)
axis_labels <- sapply(axis_class_levels, function(cls) {
safe_cls <- gsub(";", ", ", cls, fixed = TRUE)
if (cls %in% c("Other KMT2A rearrangements", "MDS-related", "MECOM rearrangement")) {
paste0("<b><u>", safe_cls, "</u></b>")
} else {
paste0("<b>", safe_cls, "</b>")
}
})
names(axis_labels) <- axis_class_levels
library(ggtext)
panel_a <- ggplot(f1_comparison_plot, aes(x = F1, y = Class, color = Category, shape = ShapeType)) +
geom_point(size = 2.5, alpha = 0.8) +
geom_vline(xintercept = 0.8, linetype = "dashed", color = "gray50", alpha = 0.5) +
scale_color_manual(values = category_colors, name = "Category") +
scale_shape_manual(
values = c("Full CV" = 16, "Full LOSO" = 1, "Collapsed CV" = 17, "Collapsed LOSO" = 2),
name = "Type",
labels = c("Full CV" = "Full (CV)", "Full LOSO" = "Full (LOSO)", "Collapsed CV" = "Collapsed (CV)", "Collapsed LOSO" = "Collapsed (LOSO)")
) +
scale_y_discrete(labels = axis_labels) +
labs(
x = "F1 Score",
y = "",
title = "F1 Scores: Full and Collapsed Classes"
) +
theme_bw() +
theme(
axis.text.x = element_markdown(),
plot.title = element_text(size = 10),
axis.text.y = element_markdown(size = 8, color = axis_text_colors),
axis.text.x = element_text(size = 9),
legend.position = "right",
legend.text = element_text(size = 8),
legend.title = element_text(size = 9)
) +
xlim(0, 1.0)
