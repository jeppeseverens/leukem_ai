# Calculate delta F1 (F1_collapsed - F1_full) for collapsed class groups
# Focus on MDS-related and other KMT2A classes that were merged
# Define the merge mapping: which full classes map to which collapsed class
merge_mapping <- list(
"MDS-related" = c("MDS-related, gene mutations", "MDS-related, cytogenetic abnormalities",
"MDS-related, TP53 mutated", "MDS.r"),
"Other KMT2A rearrangements" = c("KMT2A::ELL", "KMT2A::MLLT10","KMT2A::MLLT1", "KMT2A::MLLT4", "KMT2A::SEPT6")
)
# Calculate mean F1 per fold for full subclasses and collapsed classes
delta_f1_list <- list()
for (collapsed_class in names(merge_mapping)) {
full_classes <- merge_mapping[[collapsed_class]]
# Get F1 for the collapsed class per fold (from merged results)
collapsed_f1 <- f1_merged_loso %>%
filter(class == collapsed_class) %>%
select(fold, f1_collapsed = f1)
# Get mean F1 across the constituent full classes per fold
# (weighted average would be better but mean is simpler for visualization)
full_f1 <- f1_full_loso %>%
filter(class %in% full_classes) %>%
group_by(fold) %>%
summarise(f1_full = mean(f1, na.rm = TRUE), .groups = "drop")
# Calculate delta
delta_df <- merge(collapsed_f1, full_f1, by = "fold")
delta_df$delta_f1 <- delta_df$f1_collapsed - delta_df$f1_full
delta_df$group <- collapsed_class
delta_f1_list[[collapsed_class]] <- delta_df
}
delta_f1_data <- do.call(rbind, delta_f1_list)
# Add cohort type for coloring
delta_f1_data$cohort_type <- ifelse(
delta_f1_data$fold %in% c("AAML0531", "AAML1031", "AAML03P1"),
"Pediatric", "Adult"
)
# Calculate summary statistics for reporting
delta_summary <- delta_f1_data %>%
group_by(group) %>%
summarise(
mean_delta = mean(delta_f1, na.rm = TRUE),
sd_delta = sd(delta_f1, na.rm = TRUE),
min_f1_full = min(f1_full, na.rm = TRUE),
max_f1_full = max(f1_full, na.rm = TRUE),
min_f1_collapsed = min(f1_collapsed, na.rm = TRUE),
max_f1_collapsed = max(f1_collapsed, na.rm = TRUE),
.groups = "drop"
)
cat("Delta F1 Summary (Collapsed - Full):\n")
cat("=====================================\n")
print(delta_summary)
# Bar plot with individual fold points showing delta F1
p_delta_f1 <- ggplot(delta_f1_data, aes(x = group, y = delta_f1)) +
geom_hline(yintercept = 0, linetype = "dashed", color = "gray50") +
geom_boxplot(aes(fill = group), alpha = 0.3, outlier.shape = NA, width = 0.5) +
geom_point(aes(color = cohort_type, shape = cohort_type),
size = 3, alpha = 0.8, position = position_jitter(width = 0.1, seed = 42)) +
scale_fill_manual(values = c("MDS-related" = "#d62728",
"Other KMT2A rearrangements" = "#ff7f0e"),
guide = "none") +
scale_color_manual(values = c("Adult" = "#7eb0d5", "Pediatric" = "#fd7f6f"),
name = "Cohort Type") +
scale_shape_manual(values = c("Adult" = 16, "Pediatric" = 17),
name = "Cohort Type") +
theme_bw() +
labs(
title = "F1 Score Improvement from Class Collapsing (LOSO)",
subtitle = sprintf("MDS-related: mean dF1 = +%.2f | Other KMT2A: mean dF1 = +%.2f",
delta_summary$mean_delta[delta_summary$group == "MDS-related"],
delta_summary$mean_delta[delta_summary$group == "Other KMT2A rearrangements"]),
x = "Collapsed Class Group",
y = expression(Delta*"F1 (Collapsed - Full)")
) +
theme(
legend.position = "bottom",
plot.title = element_text(size = 12, face = "bold"),
axis.text.x = element_text(size = 10)
) +
ylim(-0.1, max(delta_f1_data$delta_f1) + 0.05)
print(p_delta_f1)
ggsave("../writing/figures_new/delta_f1_collapsed_classes.png", p_delta_f1,
width = 8, height = 6, dpi = 300)
