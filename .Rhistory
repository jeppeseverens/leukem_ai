f1_comparison$F1[f1_comparison$Class == "MDS-related, cytogenetic abnormalities"] <- 0
# Define merge mapping for connecting lines (full -> merged class)
merge_mapping <- list(
"Other KMT2A rearrangements" = c("KMT2A::ELL", "KMT2A::MLLT10", "KMT2A::MLLT4", "KMT2A::SEPT6"),
"MDS-related" = c("MDS-related, gene mutations", "MDS-related, cytogenetic abnormalities", "MDS-related, TP53 mutated", "MDS.r"),
"MECOM rearrangement" = c("GATA2;MECOM", "MECOM, other")
)
# Create category groups for coloring
f1_comparison <- f1_comparison %>%
mutate(
Category = case_when(
Class %in% c("PML::RARA", "RUNX1::RUNX1T1", "CBFB::MYH11", "DEK::NUP214", "MLLT3::KMT2A") ~ "Major rearrangements",
Class %in% c("Other KMT2A rearrangements", "KMT2A::ELL", "KMT2A::MLLT10", "KMT2A::MLLT1","KMT2A::MLLT4", "KMT2A::SEPT6") ~ "Other KMT2A rearrangements",
