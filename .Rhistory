set.seed(123)
n  <- 31
target_mean <- 12
target_sd   <- 3
# Simuleer standaardnormale data
x <- rnorm(n)
# Schaal naar exact gewenste mean en sd
x <- (x - mean(x)) / sd(x) * target_sd + target_mean
# Controle
mean(x)
sd(x)
# Eenzijdige one-sample t-test
t.test(x, mu = 10)
BSDA::z.test(x, mu = 10, sigma.x = 3)
