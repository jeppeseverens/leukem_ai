Validation = "CV") %>%
select(Class, F1, Type, Validation)
f1_merged <- outer_merged$per_class_summaries$cv %>%
filter(Model == "Global_Optimized") %>%
mutate(Class = gsub("Class: ", "", Class),
Class = fix_names(Class),
Type = "Collapsed",
F1 = Mean_F1,
Validation = "CV") %>%
select(Class, F1, Type, Validation)
# LOSO F1 summaries (same structure as CV)
f1_full_loso <- outer_unmerged$per_class_summaries$loso %>%
filter(Model == "Global_Optimized") %>%
mutate(Class = gsub("Class: ", "", Class),
Class = fix_names(Class),
Type = "Full",
F1 = Mean_F1,
Validation = "LOSO") %>%
select(Class, F1, Type, Validation)
f1_merged_loso <- outer_merged$per_class_summaries$loso %>%
filter(Model == "Global_Optimized") %>%
mutate(Class = gsub("Class: ", "", Class),
Class = fix_names(Class),
Type = "Collapsed",
F1 = Mean_F1,
Validation = "LOSO") %>%
select(Class, F1, Type, Validation)
