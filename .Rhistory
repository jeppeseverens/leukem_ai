))
}
}
}
}
}
decision_path <- file.path(
root_dir,
regime_dir,
paste0("global_ensemble_prediction_decisions_", regime_dir, "_", model_dir, "_", split_type, ".rds")
)
if (!file.exists(decision_path)) return(NULL)
decisions <- readRDS(decision_path)
out <- build_curve_from_decisions(decisions, split_type, regime_label, method_label, pool_scope = pool_scope)
if (is.null(out)) return(NULL)
return(out %>% dplyr::mutate(calibration = "Univariate"))
}
curve_path <- file.path(
root_dir,
regime_dir,
paste0("risk_coverage_heldout_curve_raw_", split_type, ".csv")
)
if (!file.exists(curve_path)) return(NULL)
raw <- read.csv(curve_path, stringsAsFactors = FALSE)
if (nrow(raw) == 0) return(NULL)
pooled <- raw %>%
dplyr::filter(model == model_dir) %>%
dplyr::mutate(
risk = 100 * (1 - accuracy),
coverage = 100 * (1 - perc_rejected)
) %>%
dplyr::group_by(prob_cutoff) %>%
dplyr::summarise(
risk = mean(risk, na.rm = TRUE),
coverage = mean(coverage, na.rm = TRUE),
.groups = "drop"
)
mono <- build_monotonic_curve(pooled)
if (is.null(mono) || nrow(mono) == 0) return(NULL)
mono %>%
dplyr::mutate(
split_type = toupper(split_type),
regime = regime_label,
method = method_label,
calibration = "Univariate"
)
}
