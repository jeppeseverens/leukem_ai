dplyr::mutate(calibration = "Multivariate"),
read_mv_curve(mv_root, "with_leftout_ood_aware", md, "cv", "OOD-aware calib.", mt, pool_scope = "full_pool") %>%
dplyr::mutate(calibration = "Multivariate"),
